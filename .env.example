# Darth Meetings — environment reference. Copy to .env.local (gitignored).
# `next build` must pass with NONE of these set — config access is lazy.

# --- darth-auth (the only identity provider; SPEC §3.6) ---
# Browser-facing base URL: login/logout redirects go here.
DARTH_AUTH_URL=https://auth.darth-internal.trames.io
# Server-side introspection base (loopback on the .6 VM). The app POSTs
# {token, service:'meetings'} to `${DARTH_AUTH_INTERNAL_URL}/api/introspect`
# for the darth_session cookie (dss_) and darth-cli bearers (dth_).
DARTH_AUTH_INTERNAL_URL=http://127.0.0.1:8790
# Legacy override of the full introspect URL — still honoured if set
# (takes precedence over DARTH_AUTH_INTERNAL_URL). Prefer the two above.
# DARTH_AUTH_INTROSPECT_URL=http://127.0.0.1:8790/api/introspect
# Absolute returnTo URLs (login/logout/no-access) are built from `Host` +
# `X-Forwarded-Proto` — both set by nginx on .6. nginx does NOT set
# X-Forwarded-Host, so it is ignored unless this is 1 (only behind a proxy
# that overwrites that header itself; never on .6 as configured).
# DARTH_TRUST_FORWARDED_HOST=0

# --- Postgres (schemas meeting_whisperer_*) ---
SCHEMA_PREFIX=prod
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=meeting_whisperer
PGUSER=meeting_whisperer
PGPASSWORD=
# PGSSLMODE=require

# --- AssemblyAI (server-only) ---
ASSEMBLYAI_API_KEY=

# --- Google (Meet import; per-user OAuth on the Settings page) ---
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID_ENG=
GOOGLE_CLIENT_SECRET_ENG=
# 32-byte hex key, AES-256-GCM for refresh tokens at rest
GOOGLE_TOKEN_ENC_KEY=
# External origin of this deployment (OAuth redirect URI is built from it)
APP_BASE_URL=https://meetings.darth-internal.trames.io

# --- Microsoft Graph, app-only (Darth Meetings Entra registration) ---
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# --- Darth family ---
# dapp_ app token for Darth Tasks /api/notify (Slack DMs on share). Absent = off.
DARTH_APP_TOKEN=
# DARTH_TASKS_URL=https://tasks.darth-internal.trames.io
# DARTH_NOTIFY_URL=https://tasks.darth-internal.trames.io/api/notify

# --- Optional knobs ---
# MW_STORAGE_DIR=./storage
# MW_PUBLIC_URL=https://meetings.darth-internal.trames.io
# MW_VOICEPRINT_URL=
# MW_VOICEPRINT_THRESHOLD=
# MW_CLAUDE_MODEL=
# MW_CLAUDE_EFFORT=
# MW_IMPORT_NORMALIZE_MODEL=
# MW_IMPORT_NORMALIZE_EFFORT=
# MW_DM_TZ=Asia/Singapore
# GMEET_POLL_MINUTES=
# HOT_RELOAD_DB_REUSE=1
